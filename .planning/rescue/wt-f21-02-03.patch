  +//! F21-02-03 — the session tool ACL must REACH a spawned child.
  +//!
  +//! `policy_gate_wired_test.rs` proves the gate is consulted once it is
  +//! present on an `AgentExecutorConfig`. It never proves the gate can get
  +//! there in the first place. Phase 21 measured the gap: `set_policy_gate`
  +//! had zero callers workspace-wide, both `AgentEngine` constructors
  +//! hard-coded `policy_gate: None`, and `AgentSpawner` never handed a gate
  +//! to a child engine — so a parent's tool ACL stopped at the parent.
  +//!
  +//! These tests drive the real `AgentSpawner` → child `AgentEngine` path
  +//! with a provider that makes the child issue a genuine `Read` tool call
  +//! against a real file, then reads back what the child's own turn saw.
  +//! With the ACL inherited the child sees a policy denial; without it the
  +//! child reads the file's contents.
  +
  +use std::sync::Arc;
  +use std::sync::atomic::{AtomicUsize, Ordering};
  +
  +use async_trait::async_trait;
  +use serde_json::json;
  +use tokio::sync::mpsc;
  +use wcore_agent::policy_gate::PolicyGate;
  +use wcore_agent::spawner::AgentSpawner;
  +use wcore_config::config::{Config, SessionConfig, ToolsConfig};
  +use wcore_providers::{LlmProvider, ProviderError};
  +use wcore_types::llm::{LlmEvent, LlmRequest};
  +use wcore_types::message::{ContentBlock, FinishReason, StopReason, TokenUsage};
  +use wcore_types::spawner::SubAgentConfig;
  +
  +/// The exact bytes the child would obtain if — and only if — its `Read`
  +/// call actually executed.
  +const CANARY: &str = "F21-02-03-CHILD-READ-CANARY";
  +
  +/// Turn 1: call `Read` on `path`. Turn 2+: echo back whatever the tool
  +/// result carried, so the child's final text IS the dispatch outcome.
  +///
  +/// This is the observation channel: a `SubAgentResult` normally reports
  +/// only the child's prose, and a policy denial is delivered to the child's
  +/// model as a tool result, not to the spawning caller.
  +struct ReadThenEchoProvider {
  +    path: String,
  +    turns: AtomicUsize,
  +}
  +
  +impl ReadThenEchoProvider {
  +    fn new(path: impl Into<String>) -> Self {
  +        Self {
  +            path: path.into(),
  +            turns: AtomicUsize::new(0),
  +        }
  +    }
  +}
  +
  +#[async_trait]
  +impl LlmProvider for ReadThenEchoProvider {
  +    async fn stream(
  +        &self,
  +        request: &LlmRequest,
  +    ) -> Result<mpsc::Receiver<LlmEvent>, ProviderError> {
  +        let (tx, rx) = mpsc::channel(4);
  +        let first_turn = self.turns.fetch_add(1, Ordering::SeqCst) == 0;
  +        if first_turn {
  +            tx.send(LlmEvent::ToolUse {
  +                id: "child-read-1".into(),
  +                name: "Read".into(),
  +                input: json!({ "file_path": self.path }),
  +                extra: None,
  +            })
  +            .await
  +            .expect("tool-use event send");
  +            tx.send(LlmEvent::Done {
  +                stop_reason: StopReason::ToolUse,
  +                finish_reason: FinishReason::from_stop_reason(StopReason::ToolUse),
  +                usage: TokenUsage::default(),
  +            })
  +            .await
  +            .expect("done event send");
  +            return Ok(rx);
  +        }
  +
  +        // Echo the most recent tool result verbatim.
